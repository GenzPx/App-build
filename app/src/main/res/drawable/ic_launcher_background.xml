<?xml version="1.0" encoding="utf-8"?>
<!--
  Monitored Check adaptive icon background.
  Deep technical blue gradient with a faint diagnostic grid, evoking instrument
  panels / system dashboards. Drawn as a vector so it stays crisp at every density.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor" xmlns:aapt="http://schemas.android.com/aapt">
            <gradient
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF12304A" />
                <item android:offset="0.55" android:color="#FF0E2436" />
                <item android:offset="1.0" android:color="#FF091823" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Diagnostic grid lines, kept inside the 72dp safe zone visual weight -->
    <group>
        <path android:pathData="M27,18 L27,90" android:strokeColor="#1A5BC8F5" android:strokeWidth="1" />
        <path android:pathData="M45,18 L45,90" android:strokeColor="#1A5BC8F5" android:strokeWidth="1" />
        <path android:pathData="M63,18 L63,90" android:strokeColor="#1A5BC8F5" android:strokeWidth="1" />
        <path android:pathData="M81,18 L81,90" android:strokeColor="#1A5BC8F5" android:strokeWidth="1" />
        <path android:pathData="M18,27 L90,27" android:strokeColor="#1A5BC8F5" android:strokeWidth="1" />
        <path android:pathData="M18,45 L90,45" android:strokeColor="#1A5BC8F5" android:strokeWidth="1" />
        <path android:pathData="M18,63 L90,63" android:strokeColor="#1A5BC8F5" android:strokeWidth="1" />
        <path android:pathData="M18,81 L90,81" android:strokeColor="#1A5BC8F5" android:strokeWidth="1" />
    </group>
</vector>
